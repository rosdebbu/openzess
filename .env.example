# ── LLM Provider Keys (add the ones you use — the app UI also stores keys client-side) ──
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
QWEN_API_KEY=your_qwen_key_here
MOONSHOT_API_KEY=your_moonshot_key_here

# ── NVIDIA NIM API (GLM-5.3-flash, Llama 3.3, etc. - https://build.nvidia.com) ──
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/z-ai/glm-5.3-flash

# ── Experiential Model Gateway (Optional: see experientiallabs/experiential) ──
# Run local gateway with: pip install experiential exp && exp run
# EXP_GATEWAY_BASE=http://127.0.0.1:8000/v1
# EXP_GATEWAY_KEY=your_xpl_key_here
# EXP_MODEL=openai/default
# OPENZESS_FALLBACK_PROVIDER=gemini

# ── Chat Bridges (optional) ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token

# ── Email Agent Tool (optional: for send_email tool in agent.py) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ── Rust Sidecar (OPTIONAL acceleration — see plans/hybrid-python-rust.md) ──
# Leave SIDECAR_URL unset to stay 100% pure-Python (default, always safe).
# To enable: cd rust-sidecar && cargo run --release, then uncomment below.
# SIDECAR_URL=http://127.0.0.1:8100
# SIDECAR_TIMEOUT=2

# ── Database ──
# Local run WITHOUT Docker (recommended default):
DATABASE_URL=sqlite:///./chat_history.db
# PostgreSQL via docker-compose.yml (app container uses the db service hostname):
# DATABASE_URL=postgresql://openzess:YOUR_STRONG_PASSWORD@db:5432/openzess

# ── Docker Compose variables (used by docker-compose.yml; copy to .env) ──
# POSTGRES_PASSWORD is REQUIRED — compose refuses to start without it.
# POSTGRES_USER=openzess
# POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
# POSTGRES_DB=openzess
# Comma-separated allowed browser origins (never use * in production):
# OPENZESS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Static API token (optional simple lock on every /api request) ──
# OPENZESS_AUTH_TOKEN=

# ── Per-user JWT auth (full-stack multi-user mode) ──
# Signing secret for JWT tokens — set a long random string in production!
# If unset, a random per-process secret is used (tokens reset on restart).
# OPENZESS_JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in minutes (default 1440 = 24h)
# OPENZESS_TOKEN_EXPIRE_MINUTES=1440
# Bootstrap admin account (created on startup only if no admin exists)
# OPENZESS_ADMIN_EMAIL=admin@example.com
# OPENZESS_ADMIN_USERNAME=admin
# OPENZESS_ADMIN_PASSWORD=

# ── Rate limiting ──
# Max requests per minute per client (0 disables; default 240)
# OPENZESS_RATE_LIMIT=240


